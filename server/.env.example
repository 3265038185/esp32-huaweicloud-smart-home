# Copy the values you need into your shell environment.
# Do NOT commit a real .env file.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true

# MySQL
MYSQL_DATABASE=school
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Email (used by the account activation flow)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=IoT Dashboard <noreply@example.com>

# Huawei Cloud IoTDA
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=
HUAWEI_PROJECT_ID=
HUAWEI_DEVICE_ID=
HUAWEI_IOTDA_ENDPOINT=https://iotda.cn-north-4.myhuaweicloud.com
